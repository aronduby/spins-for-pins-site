<section id="intro">
    <div class="container">
        <div class="row">
            <div class="col-4 col-12-medium">
                <section class="first">
                    <i class="icon solid featured fa-burst alt2"></i>
                    <header>
                        <h2>Play Pinball</h2>
                    </header>
                    <p>Play pinball like you always do, we integrate with the pinball sites you are already using.</p>
                </section>
            </div>

            <div class="col-4 col-12-medium">
                <section class="middle">
                    <i class="icon featured">{% include logo-single-color.svg %}</i>
                    <header>
                        <h2>Click Button</h2>
                    </header>
                    <p>Click the browser button to export from your active tab to Wheel of Names for giveaways.</p>
                </section>
            </div>

            <div class="col-4 col-12-medium">
                <section class="last">
                    <i class="icon solid featured fa-rotate alt"></i>
                    <header>
                        <h2>Spin Wheel</h2>
                    </header>
                    <p>Now that all your names are automatically added, all that's left is to spin the wheel.</p>
                </section>
            </div>
        </div>

        <footer>
            <ul class="actions">
                <li>
                    <a href="/" class="button large extensionLink" target="_blank">
                        <span><span>Download Now</span></span>
                    </a>
                </li>
                <li>
                    <a href="/about" class="button large alt">
                        <span><span>Learn More</span></span>
                    </a>
                </li>
            </ul>
            <details>
                <summary>Download button not working?</summary>

                <p>We might not be able to tell what browser you're using. You can download the <a href="{{ site.chromeUrl }}" target="_blank">Chrome Extension</a>,
                    or the <a href="{{ site.firefoxUrl }}" target="_blank">Firefox Add-on</a>.</p>
            </details>
        </footer>
    </div>
</section>